# Copy this file to .env and replace every placeholder.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8787
GEMINI_MODEL=gemini-2.5-flash
# Add keys separated by commas. Do not commit .env or share it.
GEMINI_API_KEYS=REPLACE_WITH_GEMINI_KEY_1,REPLACE_WITH_GEMINI_KEY_2
MIN_AI_CONFIDENCE=0.70
MAX_RISK_PERCENT=0.25
MAX_SPREAD_POINTS=80
GEMINI_TIMEOUT_SECONDS=18
KEY_COOLDOWN_SECONDS=90
LOG_LEVEL=INFO
# Telegram is optional. Create a bot with BotFather and allow only your numeric chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
