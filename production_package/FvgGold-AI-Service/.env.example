# ==============================================================================
# FvgGold AI Trader - Production Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (never commit or publicly publish .env).
# 2. Generate a secure 48+ character service token in terminal / PowerShell:
#       python -c "import secrets; print(secrets.token_urlsafe(48))"
# 3. Paste the generated token into AI_SERVICE_TOKEN below.
# 4. Copy that EXACT same token into MT5 EA Input 'AIServiceToken'.
# ==============================================================================

# Shared Service Secret (Authentication between MT5 EA and Python Service)
# CRITICAL: Must be at least 32 random characters. Never use default placeholder!
AI_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Server Host and Port (Only used in Standalone HTTP / Windows VPS mode)
# On Shared Hosting (cPanel / Passenger), the web server manages the port automatically.
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8787

# Gemini AI API Configuration
# Get keys from Google AI Studio: https://aistudio.google.com/app/apikey
# Multiple keys can be comma-separated for rotation and failover.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEYS=REPLACE_WITH_GEMINI_KEY_1,REPLACE_WITH_GEMINI_KEY_2

# Conservative AI & Risk Guardrails
MIN_AI_CONFIDENCE=0.70
MAX_RISK_PERCENT=0.25
MAX_SPREAD_POINTS=80
GEMINI_TIMEOUT_SECONDS=12
KEY_COOLDOWN_SECONDS=90
MAX_REQUEST_DRIFT_SECONDS=60

# Database Storage Option
# Supported: 'sqlite' (zero-config file database) or 'mysql' (cPanel / remote MySQL)
DB_TYPE=sqlite
# MySQL Settings (Only needed if DB_TYPE=mysql):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fvg_user
DB_PASSWORD=
DB_NAME=fvggold_db

# Diagnostic & Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Telegram Remote Notifications & Controls (Optional)
# Leave blank to disable Telegram integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
